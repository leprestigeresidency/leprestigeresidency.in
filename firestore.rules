rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin check function
    // For this example, we assume anyone authenticated is an admin.
    // In production, this should check a custom claim or an admin collection.
    function isAdmin() {
      return request.auth != null;
    }

    match /contactMessages/{messageId} {
      // Anyone can create a contact message (guest enquiry)
      allow create: if true;
      
      // Only admins can read, update, or delete enquiries
      allow read, update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      // Anyone can submit feedback
      allow create: if true;
      
      // Anyone can read approved feedback (for public display if needed)
      // but we allow admins to read all feedback
      allow read: if resource.data.status == 'approved' || isAdmin();
      
      // Only admins can update or delete feedback
      allow update, delete: if isAdmin();
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
