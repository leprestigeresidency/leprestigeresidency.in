rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to get the current user's profile document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper to check if the user is an admin
    function isAdmin() {
      return request.auth != null && getUserData().role == 'admin';
    }

    // Helper to verify branch permission
    function hasBranchAccess(branchId) {
      return isAdmin() && getUserData().branchId == branchId;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin(); // Could restrict cross-branch if needed, but simple for now
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow write: if hasBranchAccess(resource.data.branchId) || hasBranchAccess(request.resource.data.branchId);
    }

    match /bookings/{bookingId} {
      // Guests or apps might read their own or allow create
      allow create: if true; // Public website can create bookings
      // Anyone might need to read if searching by ref number directly, or only admins
      allow read: if true; 
      allow update, delete: if hasBranchAccess(resource.data.branchId);
    }
    
    match /guests/{guestId} {
      allow read: if true; // Might need more careful rules later
      allow create: if true;
      allow update, delete: if hasBranchAccess(resource.data.branchId);
    }

    match /payments/{paymentId} {
      allow create: if true;
      allow read, update, delete: if hasBranchAccess(resource.data.branchId);
    }

    match /invoices/{invoiceId} {
      allow create: if true;
      allow read, update, delete: if hasBranchAccess(resource.data.branchId);
    }

    match /notifications/{notificationId} {
      allow create: if true;
      allow read, update, delete: if hasBranchAccess(resource.data.branchId);
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if true;
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /contact/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
